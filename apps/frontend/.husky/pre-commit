cd apps/frontend

CHANGED_FILES=$(git diff --cached --name-only)

if echo "$CHANGED_FILES" | grep -qE '\.(js|jsx|ts|tsx|css|scss)$'; then
  echo "📝 Code files changed - running lint-staged"
  bunx lint-staged
else
  echo "⏭️  No code files changed - committing docs/config"

  # Still format non-code files
  if echo "$CHANGED_FILES" | grep -qE '\.(json|md|yml|yaml)$'; then
    echo "📄 Formatting documentation/config files"
    bun run format
  fi
fi
